# Copy to .env and fill in. Never commit .env.

# Required: TypeSafe API key dedicated to Spend Gate (not your personal demo key)
TYPESAFE_API_KEY=

# Optional TypeSafe
TYPESAFE_MODEL=jev-latest
PORT=8787
TASK_FIT_THRESHOLD=0.55
VALUE_THRESHOLD=0.5

# x402 — charge callers for each decision (Jev cost + margin)
# Leave X402_PAY_TO empty for free local testing (X402_REQUIRED=false).
X402_PAY_TO=
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=https://x402.org/facilitator
GATE_PRICE_USD=0.001
X402_REQUIRED=false
